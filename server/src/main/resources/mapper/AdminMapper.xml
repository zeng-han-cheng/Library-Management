<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.library.server.mapper.AdminMapper">
<select id="findByUsername" resultType="Admin">SELECT * FROM admin WHERE username=#{username}</select><select id="findById" resultType="Admin">SELECT * FROM admin WHERE id=#{id}</select><select id="page" resultType="Admin">SELECT * FROM admin WHERE (#{keyword} IS NULL OR username LIKE CONCAT('%',#{keyword},'%') OR real_name LIKE CONCAT('%',#{keyword},'%')) ORDER BY id DESC LIMIT #{offset},#{limit}</select><select id="count" resultType="long">SELECT COUNT(*) FROM admin WHERE (#{keyword} IS NULL OR username LIKE CONCAT('%',#{keyword},'%') OR real_name LIKE CONCAT('%',#{keyword},'%'))</select><insert id="insert" parameterType="Admin" useGeneratedKeys="true" keyProperty="id">INSERT INTO admin(username,password,real_name,phone,status) VALUES(#{username},#{password},#{realName},#{phone},COALESCE(#{status},1))</insert><update id="update" parameterType="Admin">UPDATE admin SET username=#{username},real_name=#{realName},phone=#{phone},status=#{status}<if test="password != null and password != ''">,password=#{password}</if> WHERE id=#{id}</update><update id="updatePassword">UPDATE admin SET password=#{password} WHERE id=#{id}</update><delete id="delete">DELETE FROM admin WHERE id=#{id}</delete></mapper>
