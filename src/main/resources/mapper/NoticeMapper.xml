<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.library.mapper.NoticeMapper"><select id="publicList" resultType="Notice">SELECT * FROM notice WHERE publish_status=1 ORDER BY published_at DESC,id DESC</select><select id="page" resultType="Notice">SELECT * FROM notice ORDER BY id DESC LIMIT #{offset},#{limit}</select><select id="count" resultType="long">SELECT COUNT(*) FROM notice</select><insert id="insert" parameterType="Notice" useGeneratedKeys="true" keyProperty="id">INSERT INTO notice(title,content,admin_id,publish_status,published_at) VALUES(#{title},#{content},#{adminId},COALESCE(#{publishStatus},0),#{publishedAt})</insert><update id="update" parameterType="Notice">UPDATE notice SET title=#{title},content=#{content},publish_status=#{publishStatus},published_at=#{publishedAt} WHERE id=#{id}</update><delete id="delete">DELETE FROM notice WHERE id=#{id}</delete></mapper>
